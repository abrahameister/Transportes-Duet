# Configuración de Variables de Entorno del Ecosistema SaaS WFM
# Copiar este archivo como .env para desarrollo local o configurar en Netlify / Railway / Vercel / Expo

# ==============================================================================
# 1. SUPABASE CREDENTIALS (BACKEND CORE & REALTIME)
# ==============================================================================
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"
VITE_SUPABASE_ANON_KEY="tu-clave-anonima-publica-de-supabase"

# Clave Administrativa (SÓLO PARA WORKER EN RAILWAY Y SCRIPTS DE SEEDING DEV - NUNCA en Frontend/Mobile)
SUPABASE_SERVICE_ROLE_KEY="tu-clave-secreta-service-role"
DATABASE_URL="postgresql://postgres:password@db.tu-proyecto.supabase.co:5432/postgres"

# ==============================================================================
# 2. CONFIGURACIÓN DEL WORKER WFM (RAILWAY)
# ==============================================================================
PORT=3000
WFM_DISPATCH_INTERVAL_MS=5000 # Interválo de chequeo de viajes pendientes para despacho
NODE_ENV="development"

# ==============================================================================
# 3. EXPO / REACT NATIVE CLIENT CONFIG
# ==============================================================================
EXPO_PUBLIC_SUPABASE_URL="https://tu-proyecto.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="tu-clave-anonima-publica-de-supabase"
EXPO_PUBLIC_DEFAULT_ACCENT_COLOR="#E8832A" # Naranja Vibrante obligatorio
