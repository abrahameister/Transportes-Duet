# Configuración de Variables de Entorno - Neira Transportes
# Copiar este archivo como .env para desarrollo local o configurar en Netlify

# ==============================================================================
# 1. SUPABASE CREDENTIALS (FRONTEND)
# Estas variables son públicas (seguras para VITE_). RLS protege los datos.
# ==============================================================================
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"
VITE_SUPABASE_ANON_KEY="tu-clave-anonima-publica-de-supabase"

# ==============================================================================
# 2. SUPABASE CREDENTIALS (BACKEND CI/TESTING)
# ==============================================================================
# SÓLO PARA ENTORNO DE PRUEBAS / CI (pgTAP tests) - ¡NUNCA EXPONER EN FRONTEND NI NETLIFY!
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres"

# SÓLO PARA EDGE FUNCTIONS (Variables configuradas internamente en Supabase)
# SUPABASE_SERVICE_ROLE_KEY="tu-clave-secreta-service-role"
