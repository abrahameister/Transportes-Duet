# ==============================================================================
# ARCHIVO DE EXCLUSIÓN GIT (.gitignore) — ECOSISTEMA TRANSPORTES DUET
# ==============================================================================

# Dependencias de Node / NPM
node_modules/
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-lock.yaml
.pnpm-store/

# Archivos de Compilación y Bundles de Producción
dist/
build/
out/
.next/
.expo/
.cache/
.vite/
*.tsbuildinfo

# Variables de Entorno y Claves Secretas (SEGURIDAD)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# Archivos y Caché de IDEs / Editores
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.gemini/
.agents/
.system_generated/
.user_uploaded/

# Archivos de Sistema Operativo
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.stackdump

# Logs temporales y scratch
logs
*.log
npm-debug.log*
debug.log*

# Resguardos de carpetas vacias de desarrollo
tmp/
scratch/
